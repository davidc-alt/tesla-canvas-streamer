{
  "name": "tesla-canvas-streamer",
  "version": "1.0.0",
  "description": "Low-overhead WebSocket canvas streamer for embedded browsers",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "postinstall": "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o ./yt-dlp && chmod a+rx ./yt-dlp || true",
    "start": "node server.js",
    "tunnel": "npx localtunnel --port 3000 --subdomain david-tesla-streamer"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsmpeg-player": "^3.0.3",
    "ws": "^8.18.0",
    "youtube-sr": "^4.3.12",
    "yt-dlp-exec": "^1.0.2"
  }
}
